NODE_ENV=production
PORT=5000
USE_MOCK_DB=false
PAYMENT_ENVIRONMENT=LIVE

# Store these only in the hosting provider's secret manager.
RAZORPAY_KEY_ID_LIVE=
RAZORPAY_KEY_SECRET_LIVE=
RAZORPAY_WEBHOOK_SECRET_LIVE=

# Keep separate test credentials for staging.
RAZORPAY_KEY_ID_TEST=
RAZORPAY_KEY_SECRET_TEST=
RAZORPAY_WEBHOOK_SECRET_TEST=

FIREBASE_PROJECT_ID=kartkirana-3cd12
# Prefer GOOGLE_APPLICATION_CREDENTIALS or workload identity. Alternatively,
# provide a JSON object/path through FIREBASE_SERVICE_ACCOUNT_KEY.
FIREBASE_SERVICE_ACCOUNT_KEY=

ALLOWED_ORIGINS=https://kartkirana.com,https://www.kartkirana.com,https://admin.kartkirana.com,https://customer.kartkirana.com,https://rider.kartkirana.com
MAINTENANCE_MODE=false
