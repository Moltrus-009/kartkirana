# Copy to .env for local development. NEVER commit a populated .env — inject
# real values via your CI/CD pipeline's secret store for staging/production.

# Firebase web config (safe to be public per Firebase's own docs — security is
# enforced by Firestore/Storage Security Rules and App Check, not by hiding
# these values). Get these from Firebase Console > Project Settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web push (FCM) — from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# App Check (reCAPTCHA Enterprise site key) — required for production builds
VITE_RECAPTCHA_ENTERPRISE_KEY=

# Razorpay publishable key ID (test or live — switch via pipeline per environment)
VITE_RAZORPAY_KEY_ID=

# Backend dispatch/video-call API origin.
# MUST be a real, publicly routable HTTPS origin per environment
# (dev/staging/prod). Never a private LAN IP or plain http://. See
# src/lib/apiConfig.ts — production builds will refuse to start otherwise.
VITE_API_URL=https://api.example.com

# Map tiles. The default in the app is OpenStreetMap standard tiles with
# visible attribution. Set these to a contracted map provider for high-volume
# production use; do not point Leaflet directly at Google tile URLs.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
