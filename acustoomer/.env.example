# Firebase Configuration
# Replace these with your actual Firebase project settings.
# If these variables are not provided, the application will default to High-Fidelity Mock Mode.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
# Register customer.kartkirana.com with this reCAPTCHA Enterprise/App Check key.
VITE_RECAPTCHA_ENTERPRISE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY
# Internal/sideloaded debug APK only. Never enable this in the Play Store AAB.
VITE_NATIVE_APPCHECK_DEBUG=false

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# API Configuration
VITE_API_BASE_URL=https://api-lna3kdnwxq-el.a.run.app
VITE_API_URL=https://api-lna3kdnwxq-el.a.run.app
